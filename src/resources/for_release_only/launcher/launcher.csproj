<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>

    <!-- 图标 -->
    <ApplicationIcon>..\..\icon.ico</ApplicationIcon>

    <!-- 构建时传 -p:IsLite=true 参数-->
    <IsLite Condition="'$(IsLite)' == ''">false</IsLite>
    <!-- 供 #if LITE 使用 -->
    <DefineConstants Condition="'$(IsLite)' == 'true'">$(DefineConstants);LITE</DefineConstants>

    <!-- 输出文件名 -->
    <AssemblyName Condition="'$(IsLite)' == 'true'">HachimiDX-Lite</AssemblyName>
    <AssemblyName Condition="'$(IsLite)' != 'true'">HachimiDX</AssemblyName>

    <!-- Version 会自动填充 AssemblyVersion(产品版本) 和 FileVersion(文件版本) -->
    <Version>1.0.3</Version>
    <!-- 禁用 SourceLink 避免 commit hash 附加到产品版本 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Windows 文件属性 → 文件说明 -->
    <AssemblyTitle Condition="'$(IsLite)' == 'true'">Launcher for HachimiDX Lite</AssemblyTitle>
    <AssemblyTitle Condition="'$(IsLite)' != 'true'">Launcher for HachimiDX</AssemblyTitle>
    <!-- Windows 文件属性 → 产品名称 -->
    <Product Condition="'$(IsLite)' == 'true'">Launcher for HachimiDX Lite</Product>
    <Product Condition="'$(IsLite)' != 'true'">Launcher for HachimiDX</Product>
    <!-- Windows 文件属性 → 公司 -->
    <Company>GitHub: ck2739046/HachimiDX</Company>
    <!-- Windows 文件属性 → 版权 -->
    <Copyright>©Simon273 $([System.DateTime]::Now.ToString("yyyy.MM.dd_HH:mm:ss_UTCzzz"))</Copyright>
  
  </PropertyGroup>

</Project>
